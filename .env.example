# DeepSeek（platform.deepseek.com → API Keys，需充值）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# 智谱开放平台（open.bigmodel.cn，实名认证后 GLM-4V-Flash 免费）
ZHIPU_API_KEY=xxxxxxxxxxxxxxxx.xxxxxxxx

# MinerU 在线 API（mineru.net，可选，每日免费 5000 份；不填则 OCR 增援不可用）
MINERU_API_KEY=

# Agent 发相对路径时的解析根目录（可选，如 C:/Users/you/Desktop）
WORKSPACE_ROOT=

# 服务器部署时取消注释（允许其他电脑连接）：
# EYES_HOST=0.0.0.0
# EYES_PORT=8000

# 客户端连接本代理用的 key，自己随便定一个复杂点的；留空则本机不校验
PROXY_API_KEY=my-eyes-secret-2025
